# 로컬 실행용 환경 변수 예시. 이 파일을 복사해 backend/.env 로 만들고 값을 채운다. (.env는 커밋 금지)
# local 프로필의 Spring과 docker compose가 함께 읽는다. dev/prod는 서버 환경 변수로 넣는다.

# DB
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/visafe
DB_USERNAME=visafe
DB_PASSWORD=visafe

# 서버
SERVER_PORT=8080

# JWT 서명 키 (32바이트 이상). 주석으로 두면 local 전용 기본값을 쓴다. (빈 값으로 두면 시작 실패)
# 만들기: openssl rand -base64 48
# JWT_SECRET=

# CORS 허용 프론트 주소 (쉼표로 구분). 주석으로 두면 localhost:3000, localhost:5173
# CORS_ALLOWED_ORIGINS=
